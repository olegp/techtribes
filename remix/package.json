{
  "name": "techtribes-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Techtribes static site (React Router framework mode, prerendered)",
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.ts",
    "preview": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "isbot": "^5",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  }
}
